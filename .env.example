# ==============================================================================
# WorldRisk Atlas — Environment Variables
# ==============================================================================

# Database Connection (SQLite file path relative to prisma/schema.prisma)
DATABASE_URL="file:../db/custom.db"

# ------------------------------------------------------------------------------
# Ingestion & Data Sources (Optional)
# ------------------------------------------------------------------------------

# Automatic background scheduler (1 = enabled [default], 0 = disabled)
INGEST_SCHEDULER=1

# UN OCHA ReliefWeb Disasters API v2 Application Identifier (Optional)
# Get credentials at: https://apidoc.reliefweb.int
RELIEFWEB_APPNAME=""

# NASA FIRMS (Fire Information for Resource Management System) Map Key (Optional)
# Obtain a free MAP_KEY from: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=""

# Admin bearer token for triggering protected manual imports via POST /api/ingest/run
ADMIN_TOKEN=""
