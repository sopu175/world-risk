{
    "name": "worldriskatlas/backend-yii2",
    "description": "WorldRisk Atlas — production REST API backend (Yii2 + PostgreSQL 15 + PostGIS 3)",
    "type": "project",
    "license": "proprietary",
    "keywords": ["yii2", "rest", "hazard", "postgis"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "yiisoft/yii2": "~2.0.50",
        "yiisoft/yii2-httpclient": "~2.0",
        "vlucas/phpdotenv": "^5"
    },
    "suggest": {
        "ext-curl": "Enables the cURL transport in the SSRF-guarded HTTP client (IPv4 pinning, stricter timeouts). Falls back to streams when missing.",
        "ext-mbstring": "Multibyte-safe string truncation for upstream text fields."
    },
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "api\\": "api/",
            "console\\": "console/"
        }
    },
    "config": {
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "serve": "php yii serve",
        "migrate": "php yii migrate --interactive=0",
        "bootstrap-data": "php yii ingest/bootstrap"
    }
}
